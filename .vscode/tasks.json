{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "Dafault build",
            "command": "go",
            "args": [
                "build",
                "-trimpath",
                "-ldflags=-s",
            ],
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        }
    ]
}
